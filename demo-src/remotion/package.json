{
  "name": "vg-remotion-demos",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "narration:tts": "python narration/tts.py path/to/kokoro-models",
    "narration:timestamps": "python narration/timestamps.py",
    "render:kinetic": "remotion render KineticChart out/KineticChart.mp4 --crf=23",
    "render:narrated": "remotion render NarratedExplainer out/NarratedExplainer.mp4 --crf=23",
    "render:formats": "remotion render FormatsSideBySide out/FormatsSideBySide.mp4 --crf=23"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "@remotion/media": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
